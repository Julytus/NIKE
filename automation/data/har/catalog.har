\":\"lifestyle\",\"name\":\"Lifestyle\",\"sortOrder\":1,\"productCount\":12,\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-dunk-low-retro/1.webp\"},{\"id\":2,\"slug\":\"running\",\"name\":\"Running\",\"sortOrder\":2,\"productCount\":6,\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-alphafly-4/1.webp\"},{\"id\":3,\"slug\":\"basketball\",\"name\":\"Basketball\",\"sortOrder\":3,\"productCount\":5,\"imageUrl\":\"http://localhost:9020/nike-public/products/ja-4-blur-ep/1.webp\"},{\"id\":4,\"slug\":\"jordan\",\"name\":\"Jordan\",\"sortOrder\":4,\"productCount\":5,\"imageUrl\":\"http://localhost:9020/nike-public/products/air-jordan-1-low-se-magic-ball/1.webp\"},{\"id\":5,\"slug\":\"football\",\"name\":\"Football\",\"sortOrder\":5,\"productCount\":2,\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-phantom-6-low-academy/1.webp\"}]}"},"headersSize":-1,"bodySize":-1,"redirectURL":""},"cache":{},"timings":{"send":-1,"wait":-1,"receive":0.738},"_frameref":"frame@13345002595e6aceaa35bb2e95d2bc96","_monotonicTime":13424.437,"_resourceType":"xhr"},{"startedDateTime":"2026-11-20T10:20:19.313Z","time":0.715,"request":{"method":"GET","url":"http://localhost:9500/api/product/public/list?page=1&limit=12","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"application/json, text/plain, */*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"vi-VN"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost:9500"},{"name":"Origin","value":"http://localhost:4500"},{"name":"Referer","value":"http://localhost:4500/"},{"name":"Sec-Fetch-Dest","value":"empty"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-site"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[{"name":"page","value":"1"},{"name":"limit","value":"12"}],"headersSize":-1,"bodySize":-1},"response":{"status":200,"statusText":"","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Access-Control-Allow-Credentials","value":"true"},{"name":"Access-Control-Allow-Origin","value":"http://localhost:4500"},{"name":"Access-Control-Expose-Headers","value":"*"},{"name":"Connection","value":"keep-alive"},{"name":"Content-Type","value":"application/json"},{"name":"Date","value":"Fri, 20 Nov 2026 10:20:18 GMT"},{"name":"Keep-Alive","value":"timeout=60"},{"name":"Transfer-Encoding","value":"chunked"},{"name":"Vary","value":"Origin"},{"name":"Vary","value":"Access-Control-Request-Method"},{"name":"Vary","value":"Access-Control-Request-Headers"}],"content":{"size":-1,"mimeType":"application/json","text":"{\"code\":200,\"message\":\"OK\",\"result\":{\"total\":30,\"page\":1,\"items\":[{\"id\":2,\"slug\":\"nike-dunk-low-retro\",\"styleCode\":\"IQ0157-001\",\"name\":\"Nike Dunk Low Retro\",\"subtitle\":\"Men's Shoes\",\"gender\":\"MEN\",\"categoryId\":1,\"description\":\"You can always count on a classic. This Dunk Low features a synthetic leather and textile upper with zigzag stitching for a retro look. Like all Dunks, it has plush padding for game-changing comfort that lasts.\",\"price\":3519000,\"salePrice\":null,\"badge\":\"JUST_IN\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-11-08T09:00:00\",\"updatedTime\":\"2026-11-08T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-dunk-low-retro/1.webp\",\"totalStock\":220},{\"id\":5,\"slug\":\"nike-air-max-95-big-bubble-premium\",\"styleCode\":\"IQ0229-001\",\"name\":\"Nike Air Max 95 Big Bubble Premium\",\"subtitle\":\"Men's Shoes\",\"gender\":\"MEN\",\"categoryId\":1,\"description\":\"Bigger. Bouncier. Air. Staying true to the original human anatomy-inspired design, rippling layers of synthetic leather and airy mesh stack for a gradient look. The larger Max Air units in the heel and forefoot highlight the supremely cushioned design while elevating your style. Put a little more Air down there and enjoy your Air Max journey.\",\"price\":5279000,\"salePrice\":null,\"badge\":\"JUST_IN\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-11-07T09:00:00\",\"updatedTime\":\"2026-11-07T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-air-max-95-big-bubble-premium/1.webp\",\"totalStock\":240},{\"id\":14,\"slug\":\"nike-alphafly-4\",\"styleCode\":\"IM5546-800\",\"name\":\"Nike Alphafly 4\",\"subtitle\":\"Men's Road Racing Shoes\",\"gender\":\"MEN\",\"categoryId\":2,\"description\":\"Our iconic racing shoe is back and lighter than ever. We've updated the Air Zoom unit for the first time in the Alphafly's history, making it softer and quieter. Advancements to our ZoomX foam deliver more bounce with less weight, opening up your marathon potential.\",\"price\":8059000,\"salePrice\":null,\"badge\":\"JUST_IN\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-11-06T09:00:00\",\"updatedTime\":\"2026-11-06T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-alphafly-4/1.webp\",\"totalStock\":220},{\"id\":20,\"slug\":\"ja-4-blur-ep\",\"styleCode\":\"IM4136-501\",\"name\":\"Ja 4 'Blur' EP\",\"subtitle\":\"Basketball Shoes\",\"gender\":\"UNISEX\",\"categoryId\":3,\"description\":\"Ja’s elevation is pure hang-time horror, and the Ja 4 packs the bounce that creates unguardable nightmares. Responsive Cushlon 3.0 foam delivers explosive lift and cushions every landing. Its sleek containment system pairs with a supportive upper to help you stay locked in and ready to terrorise any defender in your wake.\",\"price\":3669000,\"salePrice\":null,\"badge\":\"JUST_IN\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-11-05T09:00:00\",\"updatedTime\":\"2026-11-05T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/ja-4-blur-ep/1.webp\",\"totalStock\":241},{\"id\":23,\"slug\":\"caitlin-1-midnight-fever\",\"styleCode\":\"IQ2350-600\",\"name\":\"Caitlin 1 'Midnight Fever'\",\"subtitle\":\"Girls' Basketball Shoes\",\"gender\":\"GIRLS\",\"categoryId\":3,\"description\":\"If Caitlin can make it from anywhere, so can you. The Caitlin 1 is made for those brave enough to chase down their dreams—and launch from deep. Cushlon foam helps you stay smooth and controlled through every move. The innovative Opticast upper delivers lightweight, locked-in support, so you can fearlessly hit the turbo button. Finished with signature details special to Caitlin, this shoe is made for hoopers who dare to shoot from any distance.\",\"price\":2809000,\"salePrice\":null,\"badge\":\"JUST_IN\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-11-04T09:00:00\",\"updatedTime\":\"2026-11-04T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/caitlin-1-midnight-fever/1.webp\",\"totalStock\":120},{\"id\":24,\"slug\":\"air-jordan-1-low-se-magic-ball\",\"styleCode\":\"IX6375-001\",\"name\":\"Air Jordan 1 Low SE 'Magic Ball'\",\"subtitle\":\"Men's Shoes\",\"gender\":\"MEN\",\"categoryId\":4,\"description\":\"Inspired by the original that debuted in 1985, the Air Jordan 1 Low offers a clean, classic look that's familiar yet always fresh. With an iconic design that features details celebrating 30 years of Space Jam, these kicks ensure you'll always be on point.\",\"price\":3669000,\"salePrice\":null,\"badge\":\"JUST_IN\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-11-03T09:00:00\",\"updatedTime\":\"2026-11-03T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/air-jordan-1-low-se-magic-ball/1.webp\",\"totalStock\":240},{\"id\":25,\"slug\":\"jordan-spizike-low-jam-central\",\"styleCode\":\"IX6381-001\",\"name\":\"Jordan Spizike Low 'Jam Central'\",\"subtitle\":\"Men's Shoes\",\"gender\":\"MEN\",\"categoryId\":4,\"description\":\"The Spizike takes elements of five classic Jordans, combines them and gives you one iconic sneaker. It's an homage to Spike Lee formally introducing Hollywood and hoops in a culture moment—and this pair celebrates 30 years of Space Jam with special details, like the Hare Jumpman on the tongue. You get a great-looking pair of kicks with some history. What more can you ask for? Ya dig?\",\"price\":4999000,\"salePrice\":null,\"badge\":\"JUST_IN\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-11-02T09:00:00\",\"updatedTime\":\"2026-11-02T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/jordan-spizike-low-jam-central/1.webp\",\"totalStock\":220},{\"id\":26,\"slug\":\"air-jordan-1-low-se-lola-bunny\",\"styleCode\":\"IX6038-100\",\"name\":\"Air Jordan 1 Low SE 'Lola Bunny'\",\"subtitle\":\"Women's Shoes\",\"gender\":\"WOMEN\",\"categoryId\":4,\"description\":\"The Tune Squad is back with a fresh take on '90s nostalgia the whole family can rep, celebrating 30 years of Space Jam with Lola Bunny's signature style. Inspired by the original that debuted in 1985, the Air Jordan 1 Low offers a clean, classic look that's familiar yet always fresh—as well as some special touches for this pair, like the Hare Jumpman on the tongue. With an iconic design that pairs perfectly with any 'fit, these kicks ensure you'll always be on point.\",\"price\":3669000,\"salePrice\":null,\"badge\":\"JUST_IN\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-11-01T09:00:00\",\"updatedTime\":\"2026-11-01T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/air-jordan-1-low-se-lola-bunny/1.webp\",\"totalStock\":200},{\"id\":22,\"slug\":\"nike-st-dynamite-werewolf\",\"styleCode\":\"IZ1672-100\",\"name\":\"Nike S.T. Dynamite 'Werewolf'\",\"subtitle\":\"Boys' Basketball Shoes\",\"gender\":\"BOYS\",\"categoryId\":3,\"description\":\"Burst onto the court in style with the S.T. Dynamite, so you can hoop, howl and hunt in style. Designed for effortless mobility on both hardwood and asphalt, these kicks are perfect for any style of play. A grippy sole ensures accuracy at high speeds, while a breathable mesh upper keeps your kiddo light on their toes. It's the ultimate game shoe for the ultimate player: your little hooper. Show your fangs and let your foes know you're team werewolf all the way!\",\"price\":1529000,\"salePrice\":null,\"badge\":\"BESTSELLER\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-10-18T09:00:00\",\"updatedTime\":\"2026-10-18T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-st-dynamite-werewolf/1.webp\",\"totalStock\":140},{\"id\":8,\"slug\":\"nike-air-max-phenomena\",\"styleCode\":\"IM8814-200\",\"name\":\"Nike Air Max Phenomena\",\"subtitle\":\"Women's Shoes\",\"gender\":\"WOMEN\",\"categoryId\":1,\"description\":\"The Air Max Phenomena reimagines the Air Max SNDR as a sleek loafer. Premium materials combined with Max Air cushioning makes it comfortable enough to wear all day and stylish enough to wear all night.\",\"price\":4409000,\"salePrice\":null,\"badge\":\"BESTSELLER\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-10-02T09:00:00\",\"updatedTime\":\"2026-10-02T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-air-max-phenomena/1.webp\",\"totalStock\":200},{\"id\":15,\"slug\":\"nike-vomero-18\",\"styleCode\":\"HM6804-013\",\"name\":\"Nike Vomero 18\",\"subtitle\":\"Women's Road Running Shoes\",\"gender\":\"WOMEN\",\"categoryId\":2,\"description\":\"Maximum cushioning in the Vomero provides a comfortable ride for everyday runs. Our softest, most cushioned ride has lightweight ZoomX foam stacked on top of responsive ReactX foam in the midsole. Plus, a redesigned traction pattern offers a smooth heel-to-toe transition.\",\"price\":4259000,\"salePrice\":null,\"badge\":\"BESTSELLER\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-09-25T09:00:00\",\"updatedTime\":\"2026-09-25T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-vomero-18/1.webp\",\"totalStock\":200},{\"id\":1,\"slug\":\"nike-air-force-1-07\",\"styleCode\":\"CW2288-111\",\"name\":\"Nike Air Force 1 '07\",\"subtitle\":\"Men's Shoes\",\"gender\":\"MEN\",\"categoryId\":1,\"description\":\"Comfortable, durable and timeless—it's number one for a reason. The classic '80s construction pairs smooth leather with bold details for style that tracks whether you're on court or on the go.\",\"price\":2929000,\"salePrice\":null,\"badge\":\"BESTSELLER\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-09-01T09:00:00\",\"updatedTime\":\"2026-09-01T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-air-force-1-07/1.webp\",\"totalStock\":240}]}}"},"headersSize":-1,"bodySize":-1,"redirectURL":""},"cache":{},"timings":{"send":-1,"wait":-1,"receive":0.715},"_frameref":"frame@13345002595e6aceaa35bb2e95d2bc96","_monotonicTime":13843.873,"_resourceType":"xhr"},{"startedDateTime":"2026-11-20T10:20:19.314Z","time":0.874,"request":{"method":"GET","url":"http://localhost:9500/api/product/public/facets","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"application/json, text/plain, */*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"vi-VN"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost:9500"},{"name":"Origin","value":"http://localhost:4500"},{"name":"Referer","value":"http://localhost:4500/"},{"name":"Sec-Fetch-Dest","value":"empty"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-site"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":-1,"bodySize":-1},"response":{"status":200,"statusText":"","httpVersion":"HTTP