al\":12,\"page\":1,\"items\":[{\"id\":2,\"slug\":\"nike-dunk-low-retro\",\"styleCode\":\"IQ0157-001\",\"name\":\"Nike Dunk Low Retro\",\"subtitle\":\"Men's Shoes\",\"gender\":\"MEN\",\"categoryId\":1,\"description\":\"You can always count on a classic. This Dunk Low features a synthetic leather and textile upper with zigzag stitching for a retro look. Like all Dunks, it has plush padding for game-changing comfort that lasts.\",\"price\":3519000,\"salePrice\":null,\"badge\":\"JUST_IN\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-11-08T09:00:00\",\"updatedTime\":\"2026-11-08T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-dunk-low-retro/1.webp\",\"totalStock\":220},{\"id\":5,\"slug\":\"nike-air-max-95-big-bubble-premium\",\"styleCode\":\"IQ0229-001\",\"name\":\"Nike Air Max 95 Big Bubble Premium\",\"subtitle\":\"Men's Shoes\",\"gender\":\"MEN\",\"categoryId\":1,\"description\":\"Bigger. Bouncier. Air. Staying true to the original human anatomy-inspired design, rippling layers of synthetic leather and airy mesh stack for a gradient look. The larger Max Air units in the heel and forefoot highlight the supremely cushioned design while elevating your style. Put a little more Air down there and enjoy your Air Max journey.\",\"price\":5279000,\"salePrice\":null,\"badge\":\"JUST_IN\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-11-07T09:00:00\",\"updatedTime\":\"2026-11-07T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-air-max-95-big-bubble-premium/1.webp\",\"totalStock\":240},{\"id\":14,\"slug\":\"nike-alphafly-4\",\"styleCode\":\"IM5546-800\",\"name\":\"Nike Alphafly 4\",\"subtitle\":\"Men's Road Racing Shoes\",\"gender\":\"MEN\",\"categoryId\":2,\"description\":\"Our iconic racing shoe is back and lighter than ever. We've updated the Air Zoom unit for the first time in the Alphafly's history, making it softer and quieter. Advancements to our ZoomX foam deliver more bounce with less weight, opening up your marathon potential.\",\"price\":8059000,\"salePrice\":null,\"badge\":\"JUST_IN\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-11-06T09:00:00\",\"updatedTime\":\"2026-11-06T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-alphafly-4/1.webp\",\"totalStock\":220},{\"id\":24,\"slug\":\"air-jordan-1-low-se-magic-ball\",\"styleCode\":\"IX6375-001\",\"name\":\"Air Jordan 1 Low SE 'Magic Ball'\",\"subtitle\":\"Men's Shoes\",\"gender\":\"MEN\",\"categoryId\":4,\"description\":\"Inspired by the original that debuted in 1985, the Air Jordan 1 Low offers a clean, classic look that's familiar yet always fresh. With an iconic design that features details celebrating 30 years of Space Jam, these kicks ensure you'll always be on point.\",\"price\":3669000,\"salePrice\":null,\"badge\":\"JUST_IN\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-11-03T09:00:00\",\"updatedTime\":\"2026-11-03T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/air-jordan-1-low-se-magic-ball/1.webp\",\"totalStock\":240},{\"id\":25,\"slug\":\"jordan-spizike-low-jam-central\",\"styleCode\":\"IX6381-001\",\"name\":\"Jordan Spizike Low 'Jam Central'\",\"subtitle\":\"Men's Shoes\",\"gender\":\"MEN\",\"categoryId\":4,\"description\":\"The Spizike takes elements of five classic Jordans, combines them and gives you one iconic sneaker. It's an homage to Spike Lee formally introducing Hollywood and hoops in a culture moment—and this pair celebrates 30 years of Space Jam with special details, like the Hare Jumpman on the tongue. You get a great-looking pair of kicks with some history. What more can you ask for? Ya dig?\",\"price\":4999000,\"salePrice\":null,\"badge\":\"JUST_IN\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-11-02T09:00:00\",\"updatedTime\":\"2026-11-02T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/jordan-spizike-low-jam-central/1.webp\",\"totalStock\":220},{\"id\":1,\"slug\":\"nike-air-force-1-07\",\"styleCode\":\"CW2288-111\",\"name\":\"Nike Air Force 1 '07\",\"subtitle\":\"Men's Shoes\",\"gender\":\"MEN\",\"categoryId\":1,\"description\":\"Comfortable, durable and timeless—it's number one for a reason. The classic '80s construction pairs smooth leather with bold details for style that tracks whether you're on court or on the go.\",\"price\":2929000,\"salePrice\":null,\"badge\":\"BESTSELLER\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-09-01T09:00:00\",\"updatedTime\":\"2026-09-01T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-air-force-1-07/1.webp\",\"totalStock\":240},{\"id\":3,\"slug\":\"nike-marina\",\"styleCode\":\"IH2380-001\",\"name\":\"Nike Marina\",\"subtitle\":\"Men's Slides\",\"gender\":\"MEN\",\"categoryId\":1,\"description\":\"The Nike Marina offers soft comfort and effortless style. The leather strap is smooth and sturdy, while the foam underfoot makes every step comfortable.\",\"price\":769000,\"salePrice\":null,\"badge\":\"BESTSELLER\",\"status\":\"PUBLISHED\",\"createdTime\":\"2026-08-05T09:00:00\",\"updatedTime\":\"2026-08-05T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-marina/1.webp\",\"totalStock\":240},{\"id\":30,\"slug\":\"nike-phantom-6-low-academy\",\"styleCode\":\"HJ4564-100\",\"name\":\"Nike Phantom 6 Low Academy\",\"subtitle\":\"Men's Multi-Ground Low-Top Football Boots\",\"gender\":\"MEN\",\"categoryId\":5,\"description\":\"Level up your accuracy with the Phantom 6 Academy. It powers your precision with a NikeSkin touch zone, located where you need it for clean strikes. The grippy texture helps you take advantage of scoring opportunities by bringing your foot closer to the ball.\",\"price\":2629000,\"salePrice\":null,\"badge\":null,\"status\":\"PUBLISHED\",\"createdTime\":\"2026-10-25T09:00:00\",\"updatedTime\":\"2026-10-25T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-phantom-6-low-academy/1.webp\",\"totalStock\":240},{\"id\":29,\"slug\":\"nike-mercurial-vapor-17-elite\",\"styleCode\":\"IF8508-102\",\"name\":\"Nike Mercurial Vapor 17 Elite\",\"subtitle\":\"Men's Firm-Ground Low-Top Football Boots\",\"gender\":\"MEN\",\"categoryId\":5,\"description\":\"The Vapor 17 Elite is unbelievably light. Made with Nike's lightest tech ever, it unleashes blinding quickness with its FlyLite plate and feathery Atomknit upper. That agile pairing sets you up to win in tight spaces, while its bladed traction pattern powers every sharp pivot and cut.\",\"price\":7479000,\"salePrice\":null,\"badge\":null,\"status\":\"PUBLISHED\",\"createdTime\":\"2026-10-22T09:00:00\",\"updatedTime\":\"2026-10-22T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-mercurial-vapor-17-elite/1.webp\",\"totalStock\":220},{\"id\":4,\"slug\":\"nike-waffle-racer\",\"styleCode\":\"IM8658-103\",\"name\":\"Nike Waffle Racer\",\"subtitle\":\"Men's Shoes\",\"gender\":\"MEN\",\"categoryId\":1,\"description\":\"Eras collide when you lace up in the Nike Waffle Racer. It pairs old-school running details like a moccasin-inspired upper and an iconic Waffle sole with modern details like fresh colours and a comfortable foam midsole.\",\"price\":2649000,\"salePrice\":2119000,\"badge\":null,\"status\":\"PUBLISHED\",\"createdTime\":\"2026-09-10T09:00:00\",\"updatedTime\":\"2026-09-10T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-waffle-racer/1.webp\",\"totalStock\":220},{\"id\":13,\"slug\":\"nike-revolution-8\",\"styleCode\":\"HJ9198-100\",\"name\":\"Nike Revolution 8\",\"subtitle\":\"Men's Road Running Shoes\",\"gender\":\"MEN\",\"categoryId\":2,\"description\":\"The Revolution 8 is an evolution of your faithful favourite. Every stride is cushioned thanks to a foam midsole and a flexible forefoot that makes your steps soft. Plus, the mesh upper is even more breathable than the previous iteration, so you can run in cool, collected comfort.\",\"price\":1909000,\"salePrice\":null,\"badge\":null,\"status\":\"PUBLISHED\",\"createdTime\":\"2026-09-05T09:00:00\",\"updatedTime\":\"2026-09-05T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-revolution-8/1.webp\",\"totalStock\":241},{\"id\":19,\"slug\":\"nike-precision-8-low\",\"styleCode\":\"IH1104-300\",\"name\":\"Nike Precision 8 Low\",\"subtitle\":\"Men's Basketball Shoes\",\"gender\":\"MEN\",\"categoryId\":3,\"description\":\"Score at will at the rim or from deep in the Nike Precision 8 Low. Crafted with a combination of ground control, comfort and on-court traction, this low-top design is perfect for instant impact plays when your name is called. Check in and make the plays that swing the outcome in your favour.\",\"price\":2119000,\"salePrice\":2000000,\"badge\":null,\"status\":\"PUBLISHED\",\"createdTime\":\"2026-08-28T09:00:00\",\"updatedTime\":\"2026-08-28T09:00:00\",\"imageUrl\":\"http://localhost:9020/nike-public/products/nike-precision-8-low/1.webp\",\"totalStock\":240}]}}"},"headersSize":-1,"bodySize":-1,"redirectURL":""},"cache":{},"timings":{"send":-1,"wait":-1,"receive":0.732},"_frameref":"frame@13345002595e6aceaa35bb2e95d2bc96","_monotonicTime":14276.684,"_resourceType":"xhr"},{"startedDateTime":"2026-11-20T10:20:19.745Z","time":0.897,"request":{"method":"GET","url":"http://localhost:9500/api/product/public/facets?gender=men","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"application/json, text/plain, */*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"vi-VN"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost:9500"},{"name":"Origin","value":"http://localhost:4500"},{"name":"Referer","value":"http://localhost:4500/"},{"name":"Sec-Fetch-Dest","value":"empty"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-site"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Headless