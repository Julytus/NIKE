# Sao chép thành .env để đổi (mặc định đã chạy được với môi trường local)
BASE_URL=http://localhost:4500
API_URL=http://localhost:9500/api

# Tài khoản kiểm thử
ADMIN_EMAIL=admin@downbeat.local
ADMIN_PASSWORD=Admin@123
NOACCESS_EMAIL=noaccess@downbeat.local
NOACCESS_PASSWORD=Admin@123
CUSTOMER_EMAIL=free@downbeat.local
CUSTOMER_PASSWORD=Admin@123

# Xem luồng bằng mắt: số mili giây chờ giữa các thao tác (dùng kèm --headed --workers=1)
E2E_SLOWMO=0
# Thư mục lưu ảnh chụp cho tài liệu (để trống = không chụp)
E2E_DOC_SHOTS=
