{
  "name": "nike-shoes-automation",
  "private": true,
  "version": "1.0.0",
  "description": "Bộ automation test (Playwright + JavaScript) cho cửa hàng giày mô phỏng nike.com/vn",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/run-phases.mjs",
    "test:smoke": "node scripts/run-phases.mjs --grep @smoke",
    "test:regression": "node scripts/run-phases.mjs --grep @regression",
    "test:api": "node scripts/run-phases.mjs --project=api",
    "test:stock": "node scripts/run-phases.mjs --phase=stock",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=chromium --headed --workers=1",
    "report": "playwright show-report",
    "report:stock": "playwright show-report playwright-report-stock",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.36.0",
    "@faker-js/faker": "^10.0.0",
    "@playwright/test": "1.63.0",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.3.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.36.0",
    "eslint-plugin-playwright": "^2.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  }
}
